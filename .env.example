# Environment Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini API Key & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security Limits
MAX_FILE_SIZE_MB=15
MAX_PAGE_COUNT=30
