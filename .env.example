# Environment Configuration
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=*

# Google Gemini API Key & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# Security Limits
MAX_FILE_SIZE_MB=15
MAX_PAGE_COUNT=30

# Optional: Frontend API URL (only needed if frontend is hosted separately on Vercel/Netlify)
# VITE_API_URL=https://your-backend-service.onrender.com
